{
  "name": "clipboard-q",
  "productName": "Clipboard Q",
  "version": "0.0.5",
  "description": "Quick Clipboard History + Copy and Paste in Sequence",
  "main": "index.js",
  "author": "Sandra Papo",
  "license": "MIT",
  "scripts": {
    "start": "electron index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder -mw --publish always"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "electron-localshortcut": "^3.2.1",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.1"
  },
  "devDependencies": {
    "electron": "^26.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.2824908.clipboardq",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "mas"
      ],
      "entitlements": "entitlements.mas.plist",
      "entitlementsInherit": "entitlements.mas.inherit.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSClipboardUsageDescription": "ClipboardQ needs clipboard access to help you reuse copied content.",
        "ElectronTeamId": "Y63V7L43S2"
      }
    },
    "mas": {
      "entitlements": "entitlements.mas.plist",
      "entitlementsInherit": "entitlements.mas.inherit.plist"
    }
  }
}
